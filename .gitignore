# 项目特有
参考代码/
协议和指南/
# 本机层文件（真实值只允许出现在这里，任意层级均不入库）
*.local.md
# 含内网部署信息的本机运维手册（不入库，仅存本地）
维护手册/推送到GitHub操作说明.md

# 环境变量与密钥类文件（严禁提交）
.env
.env.*
*.pem
*.key
*.keystore
*.jks
*.p12

# 日志（常携带本机绝对路径与内网地址）
*.log

# 密钥（严禁提交）
api_key/

# 用户配置（界面状态/主题/模型选择持久化，不入库）
config/settings.json
config/sessions/
config/window_state/
config/recent_projects.json
config/settings.lock
config/.*.tmp
# 运行日志（吞错无日志整改 T1，出错观测面，不入库）
config/logs/

# AI 工具本地配置（会话产物可能含本机路径与对话中的真实信息）
.claude/
.aider*
.cursor/
*.code-workspace

# 虚拟环境
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# 临时文件
.temp/
.tmp/
tmp/
cache/

# PyInstaller 构建产物与打包工具链（building/ 打包专区，见 work plans/2026-0725-1053 计划）
building/build/
building/dist/
building/tools/
# fcitx5 输入法插件编译工具链（building/build-fcitx5-qt6-plugin.sh，数百 MB aqt Qt 与源码）
.build-tools/
# aqt 在 CWD 自动写的运行日志（编译脚本每次重跑都会再生）
aqtinstall.log
# 防裸跑 pyinstaller（不带 --distpath/--workpath）在根级产物外溢入库（审计 W8）
build/
dist/
# AppImage --appimage-extract 手动解包产物
squashfs-root/

# IDE
.idea/
.vscode/
*.swp

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 测试数据
测试文件夹/

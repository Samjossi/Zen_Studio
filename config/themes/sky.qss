/* Zen Studio 晴空主题（亮色） —— 冷白微蓝 + 1px 描边体系
 * 结构与云白主题（cloud.qss）同构，仅色值不同；
 * 色板见 文档/修改记录/2026-0719-0704_多亮色主题体系与现有主题改名计划.md 第 5 节。
 * 2026-07-19 描边改版：输入/下拉白底描边、树列表卡片化、按钮实体化
 * （改版要点详见 cloud.qss 头注）。
 * 强调色 #0284c7；描边 #c6d9e6（悬停加深 #adc9dc）。
 */

QMainWindow,
QDialog {
    background-color: #fdfeff;
    color: #1e293b;
    selection-background-color: #0284c7;
    selection-color: #ffffff;
}

/* ---- 面板分区与标题行（objectName 接线见各面板代码） ---- */

/* 三栏层次：中栏纯白偏主题色 -1 级（#fdfeff），侧栏 -2 级 */
#SidePanel {
    background-color: #fbfdfe;
}

/* 面板卡片：查看器/终端/聊天的统一圆角包裹（容器 8px > 内容物 6px 圆角） */
#PanelCard {
    background-color: #ffffff;
    border: 1px solid #c6d9e6;
    border-radius: 8px;
}

#PanelTitle {
    font-weight: 500;
    padding: 2px 8px;
}

#PanelHint {
    color: #7d8da0;
    padding: 2px 8px;
}

/* 终端面板 tab 条：透明融入头部栏，激活态 2px 下划线（Multi_Cli 范式） */
#TerminalTabs {
    background: transparent;
}

#TerminalTabs::tab {
    background: transparent;
    color: #7d8da0;
    padding: 2px 8px;
    border: none;
    border-bottom: 2px solid transparent;
}

#TerminalTabs::tab:selected {
    color: #1e293b;
    border-bottom: 2px solid #0284c7;
}

#TerminalTabs::tab:hover:!selected {
    color: #1e293b;
}

/* ---- 输入与文本区：白底 + 1px 蓝调描边，焦点实色蓝 ---- */

QLineEdit,
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #c6d9e6;
    border-radius: 6px;
    padding: 3px 7px;
}

/* 代码查看器（中栏内容区）：透明融入 #PanelCard 卡片，自身去描边由卡片统一画框 */
QPlainTextEdit {
    background-color: transparent;
    border: none;
    padding: 4px;
}

QLineEdit:focus,
QTextEdit:focus {
    border: 1px solid #0284c7;
}

/* 聊天输出区：透明融入侧栏（双层 ID 压过 QTextEdit 规则） */
#SidePanel #ChatOutput {
    background-color: transparent;
    border: none;
}

/* ---- 树/列表：白底卡片化（描边 + 圆角 + 内留白），去焦点虚线 ---- */

QTreeView,
QListView {
    background: #ffffff;
    border: 1px solid #c6d9e6;
    border-radius: 6px;
    padding: 2px;
    outline: none;
}

QTreeView::item,
QListView::item {
    padding: 4px 6px;
    min-height: 20px;
    border-radius: 3px;
}

QTreeView::item:hover:!selected,
QListView::item:hover:!selected {
    background-color: rgba(2, 132, 199, 0.08);
}

QTreeView::item:selected,
QListView::item:selected {
    background-color: #0284c7;
    color: #ffffff;
}

/* ---- 下拉框：透明底（随侧栏）+ 描边，hover 描边加深 ---- */
/* 注意：本体不可设 background-color，否则 QSS 背景接管导致弹出列表选中背景失效（白底白字） */

QComboBox {
    border: 1px solid #c6d9e6;
    border-radius: 6px;
    padding: 2px 7px;
}

QComboBox:hover {
    border-color: #adc9dc;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1e293b;  /* 顶级浮层，不继承 QMainWindow 颜色 */
    border: 1px solid rgba(0, 0, 0, 0.15);
    selection-background-color: #0284c7;
    selection-color: #ffffff;
    padding: 4px;
    outline: none;
}

/* ---- 菜单栏与菜单：融入窗口、圆角浮层 ---- */

QMenuBar {
    background-color: transparent;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #0284c7;
    color: #ffffff;
}

QMenu {
    background-color: #edf3f8;
    color: #1e293b;  /* 顶级浮层，不继承 QMainWindow 颜色 */
    border: 1px solid rgba(2, 132, 199, 0.25);
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 4px 24px 4px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0284c7;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: rgba(2, 132, 199, 0.15);
    margin: 4px 8px;
}

/* ---- 按钮：实体化——白底 + 描边，hover 主题蓝微染 ---- */

QPushButton {
    background-color: #ffffff;
    border: 1px solid #c6d9e6;
    border-radius: 6px;
    padding: 3px 11px;
}

QPushButton:hover {
    background-color: rgba(2, 132, 199, 0.08);
    border-color: #adc9dc;
}

QPushButton:pressed {
    background-color: rgba(2, 132, 199, 0.13);
}

QPushButton:disabled {
    color: rgba(30, 41, 59, 0.35);
    background-color: #fafcfd;
    border-color: #d9e6ee;
}

/* ---- 分隔：1px 低存在感；splitter 把手常态透明、hover 显现 ---- */

QMainWindow::separator {
    background-color: #dde7ee;
    width: 1px;
    height: 1px;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background-color: rgba(2, 132, 199, 0.18);
}

/* ---- 隐形滚动条：无箭头、半透明圆角滑块 ---- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 0, 0, 0.22);
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 0, 0, 0.38);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 0, 0, 0.22);
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 0, 0, 0.38);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---- 状态栏与工具提示 ---- */

QStatusBar {
    background-color: transparent;
}

QStatusBar::item {
    border: none;
}

QToolTip {
    background-color: #323236;
    color: #f5f5f7;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
}

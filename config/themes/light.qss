/* Zen Studio 浅色主题
 * 配色来源：work plans/2026-0718-1112_PyGPT主页面样式配色参考说明.md 第 2.2 节
 */

QWidget {
    background-color: #ffffff;
    color: #000000;
    selection-background-color: #828282;
    selection-color: #ffffff;
}

QMainWindow::separator {
    background-color: #ebebeb;
    width: 2px;
    height: 2px;
}

/* 输入与文本区：1px 细实线直角边框 */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #dedede;
}

/* 树/列表：行高紧凑、悬停微灰、灰底白字选中 */
QTreeView,
QListView {
    background-color: #ffffff;
    border: 1px solid #dedede;
}

QTreeView::item,
QListView::item {
    padding: 4px;
    min-height: 20px;
}

QTreeView::item:hover:!selected,
QListView::item:hover:!selected {
    background-color: #ebebeb;
}

QTreeView::item:selected,
QListView::item:selected {
    background-color: #828282;
    color: #ffffff;
}

/* 菜单与按钮 */
QMenuBar,
QMenu {
    background-color: #ebebeb;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: #828282;
    color: #ffffff;
}

QPushButton {
    background-color: #ebebeb;
    border: 1px solid #dedede;
    padding: 4px 12px;
}

QPushButton:hover {
    background-color: #dedede;
}

/* 状态栏 */
QStatusBar {
    background-color: #ebebeb;
}

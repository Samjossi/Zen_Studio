/* Zen Studio 云白主题（亮色） —— 苹果风 + 1px 描边体系
 * 设计依据：文档/修改记录/2026-0719-0610_面板最小尺寸与苹果风界面改造计划.md 3.2/3.3 节
 * 2026-07-19 描边改版（实测描边层次优于色块分区，取代原"去边框化"版本）：
 *   · 输入框/下拉：白底 + 灰描边；焦点转实色强调描边（只变色不出框，不跳动）；
 *   · 树/列表：白底卡片化（描边 + 6px 圆角 + 2px 内留白，选中块不贴边）；
 *   · 按钮：实体化（白底描边，hover 主题色微染、描边加深）；
 *   · 代码查看器：白底铺满 + 1px 画框，圆角归零保持文档感；
 *   · 隐形滚动条 / 融合菜单栏状态栏 / 反色提示等苹果风基底不变。
 * 强调色 #0765d4；描边 #d2d2d7（悬停加深 #c0c0c5）。
 */

/* 窗口/对话框底色 + 全局文字/选中色（qss 的 color/selection 沿控件树继承，
 * 不触发子控件背景接管——切勿改用 QWidget 全局选择器，否则子控件会被
 * WA_StyledBackground 接管并用 palette 不透明刷底，盖住 #SidePanel 分区） */
QMainWindow,
QDialog {
    background-color: #ffffff;
    color: #1d1d1f;
    selection-background-color: #0765d4;
    selection-color: #ffffff;
}

/* ---- 面板分区与标题行（objectName 接线见各面板代码） ---- */

/* 侧栏（左/右栏）：向窗口底 #ffffff 微偏一点的灰（三栏似分未分） */
#SidePanel {
    background-color: #fafafb;
}

/* 面板标题行：统一半粗（真 Medium 字重）；提示为次级灰 */
#PanelTitle {
    font-weight: 500;
    padding: 2px 8px;
}

#PanelHint {
    color: #86868b;
    padding: 2px 8px;
}

/* 终端面板 tab 条：透明融入头部栏，激活态 2px 下划线（Multi_Cli 范式） */
#TerminalTabs {
    background: transparent;
}

#TerminalTabs::tab {
    background: transparent;
    color: #86868b;
    padding: 2px 8px;
    border: none;
    border-bottom: 2px solid transparent;
}

#TerminalTabs::tab:selected {
    color: #1d1d1f;
    border-bottom: 2px solid #0765d4;
}

#TerminalTabs::tab:hover:!selected {
    color: #1d1d1f;
}

/* ---- 输入与文本区：白底 + 1px 灰描边，焦点实色蓝 ----
 * （有 1px 边框后 padding 较无边框版减 1px，保持控件视觉高度一致） */

QLineEdit,
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 3px 7px;
}

/* 代码查看器（中栏内容区）：白底铺满 + 1px 描边画框，圆角归零 */
QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #d2d2d7;
    padding: 4px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #0765d4;
}

/* 聊天输出区：透明融入侧栏
 * （双层 ID 提升特异性：QTextBrowser 是 QTextEdit 子类，
 *   会被上方 QTextEdit 白底描边规则命中，需压过它） */
#SidePanel #ChatOutput {
    background-color: transparent;
    border: none;
}

/* ---- 树/列表：白底卡片化（描边 + 圆角 + 内留白），去焦点虚线 ---- */

QTreeView,
QListView {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 2px;
    outline: none;
}

QTreeView::item,
QListView::item {
    padding: 4px 6px;
    min-height: 20px;
    border-radius: 3px;
}

QTreeView::item:hover:!selected,
QListView::item:hover:!selected {
    background-color: rgba(7, 101, 212, 0.07);
}

QTreeView::item:selected,
QListView::item:selected {
    background-color: #0765d4;
    color: #ffffff;
}

/* ---- 下拉框：白底描边，hover 描边加深 ---- */

QComboBox {
    background-color: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 2px 7px;
}

QComboBox:hover {
    border-color: #c0c0c5;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1d1d1f;  /* 顶级浮层，不继承 QMainWindow 颜色 */
    border: 1px solid rgba(0, 0, 0, 0.15);
    selection-background-color: #0765d4;
    selection-color: #ffffff;
    padding: 4px;
    outline: none;
}

/* ---- 菜单栏与菜单：融入窗口、圆角浮层（描边保浮层层级） ---- */

QMenuBar {
    background-color: transparent;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #0765d4;
    color: #ffffff;
}

QMenu {
    background-color: #f5f5f7;
    color: #1d1d1f;  /* 顶级浮层，不继承 QMainWindow 颜色 */
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 4px 24px 4px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0765d4;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: rgba(0, 0, 0, 0.10);
    margin: 4px 8px;
}

/* ---- 按钮：实体化——白底 + 描边，hover 主题色微染 ---- */

QPushButton {
    background-color: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 3px 11px;
}

QPushButton:hover {
    background-color: rgba(7, 101, 212, 0.07);
    border-color: #c0c0c5;
}

QPushButton:pressed {
    background-color: rgba(7, 101, 212, 0.12);
}

QPushButton:disabled {
    color: rgba(29, 29, 31, 0.35);
    background-color: #f9f9fa;
    border-color: #e8e8ea;
}

/* ---- 分隔：1px 低存在感；splitter 把手常态透明、hover 显现 ---- */

QMainWindow::separator {
    background-color: #e5e5e5;
    width: 1px;
    height: 1px;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background-color: rgba(0, 0, 0, 0.12);
}

/* ---- 隐形滚动条：无箭头、半透明圆角滑块 ---- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 0, 0, 0.22);
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 0, 0, 0.38);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 0, 0, 0.22);
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 0, 0, 0.38);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---- 状态栏与工具提示 ---- */

QStatusBar {
    background-color: transparent;
}

QStatusBar::item {
    border: none;
}

/* 反色浮层提示（苹果风） */
QToolTip {
    background-color: #323236;
    color: #f5f5f7;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
}

/* Zen Studio 云白主题（亮色，原"浅色主题"） —— 苹果风
 * 设计依据：文档/修改记录/2026-0719-0610_面板最小尺寸与苹果风界面改造计划.md 3.2/3.3 节
 * 原则：去边框化（色块分区代替描边）、1px 隐形分隔、6~8px 圆角、扁平按钮、
 *       融合式菜单栏/状态栏、隐形滚动条、选中色 #0765d4。
 */

/* 窗口/对话框底色 + 全局文字/选中色（qss 的 color/selection 沿控件树继承，
 * 不触发子控件背景接管——切勿改用 QWidget 全局选择器，否则子控件会被
 * WA_StyledBackground 接管并用 palette 不透明刷底，盖住 #SidePanel 分区） */
QMainWindow,
QDialog {
    background-color: #ffffff;
    color: #1d1d1f;
    selection-background-color: #0765d4;
    selection-color: #ffffff;
}

/* ---- 面板分区与标题行（objectName 接线见各面板代码） ---- */

/* 侧栏（左/右栏）：浅灰底 */
#SidePanel {
    background-color: #f5f5f7;
}
/* 面板标题行：统一半粗（真 Medium 字重）；提示为次级灰 */
#PanelTitle {
    font-weight: 500;
    padding: 2px 8px;
}

#PanelHint {
    color: #86868b;
    padding: 2px 8px;
}

/* ---- 输入与文本区：无边框圆角色块，焦点微蓝描边 ---- */

QLineEdit,
QTextEdit {
    background-color: #f5f5f7;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
}

/* 代码查看器（中栏内容区）：白底铺满，圆角归零 */
QPlainTextEdit {
    background-color: #ffffff;
    border: none;
    padding: 4px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid rgba(7, 101, 212, 0.45);
}

/* 侧栏灰底上的输入控件：白底浮起，与侧栏区分 */
#SidePanel QTextEdit,
#SidePanel QComboBox {
    background-color: #ffffff;
}

#SidePanel QComboBox:hover {
    background-color: #f0f0f2;
}

/* 聊天输出区：透明融入侧栏
 * （双层 ID 提升特异性：QTextBrowser 是 QTextEdit 子类，
 *   会被上方 #SidePanel QTextEdit 白底规则命中，需压过它） */
#SidePanel #ChatOutput {
    background-color: transparent;
    border: none;
}

/* ---- 树/列表：透明继承面板底色、无边框、去焦点虚线 ---- */

QTreeView,
QListView {
    background: transparent;
    border: none;
    outline: none;
}

QTreeView::item,
QListView::item {
    padding: 4px;
    min-height: 20px;
}

QTreeView::item:hover:!selected,
QListView::item:hover:!selected {
    background-color: rgba(0, 0, 0, 0.045);
}

QTreeView::item:selected,
QListView::item:selected {
    background-color: #0765d4;
    color: #ffffff;
}

/* ---- 下拉框：无边框灰底圆角 ---- */

QComboBox {
    background-color: #f5f5f7;
    border: none;
    border-radius: 6px;
    padding: 3px 8px;
}

QComboBox:hover {
    background-color: #ececef;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1d1d1f;  /* 顶级浮层，不继承 QMainWindow 颜色 */
    border: 1px solid rgba(0, 0, 0, 0.10);
    selection-background-color: #0765d4;
    selection-color: #ffffff;
    padding: 4px;
    outline: none;
}

/* ---- 菜单栏与菜单：融入窗口、圆角浮层 ---- */

QMenuBar {
    background-color: transparent;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #0765d4;
    color: #ffffff;
}

QMenu {
    background-color: #f5f5f7;
    color: #1d1d1f;  /* 顶级浮层，不继承 QMainWindow 颜色 */
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 4px 24px 4px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0765d4;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: rgba(0, 0, 0, 0.10);
    margin: 4px 8px;
}

/* ---- 按钮：扁平无边框，hover 浮现圆角底 ---- */

QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 12px;
}

QPushButton:hover {
    background-color: rgba(0, 0, 0, 0.06);
}

QPushButton:pressed {
    background-color: rgba(0, 0, 0, 0.10);
}

QPushButton:disabled {
    color: rgba(29, 29, 31, 0.35);
}

/* ---- 分隔：1px 低存在感；splitter 把手常态透明、hover 显现 ---- */

QMainWindow::separator {
    background-color: #e5e5e5;
    width: 1px;
    height: 1px;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background-color: rgba(0, 0, 0, 0.12);
}

/* ---- 隐形滚动条：无箭头、半透明圆角滑块 ---- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 0, 0, 0.22);
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 0, 0, 0.38);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 0, 0, 0.22);
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 0, 0, 0.38);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---- 状态栏与工具提示 ---- */

QStatusBar {
    background-color: transparent;
}

QStatusBar::item {
    border: none;
}

/* 反色浮层提示（苹果风） */
QToolTip {
    background-color: #323236;
    color: #f5f5f7;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
}

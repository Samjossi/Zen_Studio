/* Zen Studio 主题模板（唯一 qss 源） —— 苹果风 + 1px 描边体系
 * $$token 占位符由 gui/theme.py 的 THEME_PALETTES 按主题渲染（string.Template，
 * 缺键即抛 KeyError，fail-fast）；新增主题 = THEME_PALETTES 加一行字典。
 * 模板化（2026-07-20，见 文档/修改记录/2026-0720-1046_主题模板化与去明暗族分类
 * 实施计划.md）：五副本合并为本模板，色值全部令牌化，耦合色物理同源不漂移。
 *
 * 设计依据：文档/修改记录/2026-0719-0610_面板最小尺寸与苹果风界面改造计划.md 3.2/3.3 节
 * 2026-07-19 描边改版（实测描边层次优于色块分区，取代原"去边框化"版本）：
 *   · 输入框/下拉：实底 + 描边；焦点转实色强调描边（只变色不出框，不跳动）；
 *   · 树/列表：卡片化（描边 + 6px 圆角 + 2px 内留白，选中块不贴边）；
 *   · 面板卡片 #PanelCard：查看器/终端/聊天的统一圆角包裹（8px 圆角容器，
 *     标题行 + 内容整体入卡，卡片内控件去自身描边防双重边框）；
 *   · 按钮：实体化（实底描边，hover 主题色微染、描边加深）；
 *   · 代码查看器：透明融入卡片，圆角归零保持文档感；
 *   · 隐形滚动条 / 融合菜单栏状态栏 / 反色提示等苹果风基底不变。
 */

/* 窗口/对话框底色 + 全局文字/选中色（qss 的 color/selection 沿控件树继承，
 * 不触发子控件背景接管——切勿改用 QWidget 全局选择器，否则子控件会被
 * WA_StyledBackground 接管并用 palette 不透明刷底，盖住 #SidePanel 分区） */
QMainWindow,
QDialog {
    background-color: $window_bg;
    color: $text;
    selection-background-color: $accent;
    selection-color: #ffffff;
}

/* ---- 面板分区与标题行（objectName 接线见各面板代码） ---- */

/* 侧栏（左/右栏）：向窗口底微偏一点（三栏似分未分） */
#SidePanel {
    background-color: $sidebar_bg;
}

/* 面板卡片：查看器/终端/聊天的统一圆角包裹（容器 8px > 内容物 6px 圆角；
 * 浮于窗口/侧栏底，objectName 接线见各面板代码） */
#PanelCard {
    background-color: $card_bg;
    border: 1px solid $border;
    border-radius: 8px;
}

/* 面板标题行：统一半粗（真 Medium 字重）；提示为次级灰 */
#PanelTitle {
    font-weight: 500;
    padding: 2px 8px;
}

#PanelHint {
    color: $muted_text;
    padding: 2px 8px;
}

/* 终端面板 tab 条：透明融入头部栏，激活态 2px 下划线（Multi_Cli 范式） */
#TerminalTabs {
    background: transparent;
}

#TerminalTabs::tab {
    background: transparent;
    color: $muted_text;
    padding: 2px 8px;
    border: none;
    border-bottom: 2px solid transparent;
}

#TerminalTabs::tab:selected {
    color: $text;
    border-bottom: 2px solid $accent;
}

#TerminalTabs::tab:hover:!selected {
    color: $text;
}

/* 聊天会话标签页（QTabWidget）：与 #TerminalTabs 同一范式——tab 透明底
 * 融入侧栏，激活态 2px accent 下划线；pane 去框（documentMode 之外双保险），
 * 关闭钮透明 + hover 微染（2026-0722-1725 走查 F1/F3/F5：此前零规则，
 * 平台原生渲染与终端标签同屏风格断裂） */
#ChatTabs {
    background: transparent;
}

#ChatTabs::pane {
    border: none;
    background: transparent;
}

#ChatTabs QTabBar {
    background: transparent;
}

#ChatTabs QTabBar::tab {
    background: transparent;
    color: $muted_text;
    padding: 3px 10px;
    border: none;
    border-bottom: 2px solid transparent;
}

#ChatTabs QTabBar::tab:selected {
    color: $text;
    border-bottom: 2px solid $accent;
}

#ChatTabs QTabBar::tab:hover:!selected {
    color: $text;
}

/* 关闭钮：仅定义 hover 微染——常态规则（哪怕只设 background）会让 Qt 样式表
 * 引擎接管该子控件绘制、默认 ✕ 图标消失（.temp/probe_close_button.py 对照
 * 实验实证）；不定义常态即沿用平台标准图标，与 #TerminalTabs 观感一致 */
#ChatTabs QTabBar::close-button:hover {
    background-color: $button_hover_bg;
    border-radius: 3px;
}

/* ---- 输入与文本区：实底 + 1px 描边，焦点实色强调 ----
 * （有 1px 边框后 padding 较无边框版减 1px，保持控件视觉高度一致） */

QLineEdit,
QTextEdit {
    background-color: $input_bg;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 3px 7px;
}

/* 代码查看器（中栏内容区）：透明融入 #PanelCard 卡片，自身去描边由卡片统一画框 */
QPlainTextEdit {
    background-color: transparent;
    border: none;
    padding: 4px;
}

QLineEdit:focus,
QTextEdit:focus {
    border: 1px solid $accent;
}

/* 聊天输出区：透明融入侧栏
 * （双层 ID 提升特异性：QTextBrowser 是 QTextEdit 子类，
 *   会被上方 QTextEdit 实底描边规则命中，需压过它） */
#SidePanel #ChatOutput {
    background-color: transparent;
    border: none;
}

/* ---- 树/列表：卡片化（描边 + 圆角 + 内留白），去焦点虚线 ---- */

QTreeView,
QListView {
    background: $card_bg;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 2px;
    outline: none;
}

QTreeView::item,
QListView::item {
    padding: 4px 6px;
    min-height: 20px;
    border-radius: 3px;
}

QTreeView::item:hover:!selected,
QListView::item:hover:!selected {
    background-color: $list_item_hover;
}

QTreeView::item:selected,
QListView::item:selected {
    background-color: $accent;
    color: #ffffff;
}

/* ---- 下拉框：透明底（随侧栏）+ 描边，hover 描边加深 ---- */
/* 注意（1259 事件教训，见 文档/修改记录/2026-0719-1259_下拉框选中项实心方块
 * 修复计划.md）：本体【普通态】不可设 background-color，否则 QSS 背景接管导致
 * 弹出列表选中背景失效（白底白字）；:hover 伪态背景不触发接管，可保留
 * （亮色四主题 $combo_hover_bg 为 transparent，等价于未设置） */
QComboBox {
    border: 1px solid $border;
    border-radius: 6px;
    padding: 2px 7px;
}

QComboBox:hover {
    background-color: $combo_hover_bg;
    border-color: $border_hover;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: $popup_bg;
    color: $text;  /* 顶级浮层，不继承 QMainWindow 颜色 */
    border-radius: 8px;
    border: 1px solid $popup_border;
    selection-background-color: $accent;
    selection-color: #ffffff;
    padding: 4px;
    outline: none;
}

/* ---- 菜单栏与菜单：融入窗口、圆角浮层（描边保浮层层级） ---- */

QMenuBar {
    background-color: transparent;
    /* 菜单行下移：菜单文字距窗口上边缘 24px（本 21px + ::item 上 padding 4px）。
     * 教训（2026-07-20 实测入档，见 文档/修改记录/2026-0720-1815 计划 §1）：
     * QMenuBar 的 qss padding-top 会被 Qt 镜像到底部（栏总高 = 内容高 + 2N），
     * 且 QMainWindow 布局不采纳 menubar 的 qss margin——故镜像余量由代码侧
     * setFixedHeight 截断（gui/main_window.py _fit_menubar_height），
     * 菜单栏底→卡片顶 12px = 容器 6px + 面板外边距 6px。 */
    padding-top: 21px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: $accent;
    color: #ffffff;
}

QMenu {
    background-color: $popup_bg;
    color: $text;  /* 顶级浮层，不继承 QMainWindow 颜色 */
    border: 1px solid $menu_border;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 4px 24px 4px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: $accent;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: $popup_separator;
    margin: 4px 8px;
}

/* ---- 按钮：实体化——实底 + 描边，hover 主题色微染 ---- */

QPushButton {
    background-color: $input_bg;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 3px 11px;
}

QPushButton:hover {
    background-color: $button_hover_bg;
    border-color: $border_hover;
}

QPushButton:pressed {
    background-color: $button_pressed_bg;
}

QPushButton:disabled {
    color: $button_disabled_text;
    background-color: $button_disabled_bg;
    border-color: $button_disabled_border;
}

/* 工具按钮：与 QPushButton 同一实体化范式（实底 + 描边 + 6px 圆角 + hover
 * 微染），惠及聊天/终端「+」新建钮与设置中心折叠钮（2026-0722-1725 走查
 * F4：此前全局无规则，三处均平台原生渲染） */
QToolButton {
    background-color: $input_bg;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 2px 8px;
}

QToolButton:hover {
    background-color: $button_hover_bg;
    border-color: $border_hover;
}

QToolButton:pressed {
    background-color: $button_pressed_bg;
}

QToolButton:disabled {
    color: $button_disabled_text;
    background-color: $button_disabled_bg;
    border-color: $button_disabled_border;
}

/* ---- 分隔：1px 低存在感；splitter 把手常态透明、hover 显现 ---- */

QMainWindow::separator {
    background-color: $separator;
    width: 1px;
    height: 1px;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background-color: $splitter_hover;
}

/* ---- 隐形滚动条：无箭头、半透明圆角滑块 ---- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: $scrollbar_handle;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: $scrollbar_handle_hover;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: $scrollbar_handle;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: $scrollbar_handle_hover;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---- 状态栏与工具提示 ---- */

QStatusBar {
    background-color: transparent;
}

QStatusBar::item {
    border: none;
}

/* 反色浮层提示（苹果风） */
QToolTip {
    background-color: $tooltip_bg;
    color: $tooltip_text;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
}
